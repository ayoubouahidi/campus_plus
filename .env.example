# Development template only. Run ./setup.sh to generate real local secrets.
DJANGO_SECRET_KEY=CHANGE_ME_GENERATE_A_UNIQUE_RANDOM_VALUE
DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
DJANGO_HTTPS_ENABLED=false
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false
REDIS_URL=redis://127.0.0.1:6379/0
WS_AUTH_BACKEND=token_dev

# Docker/PostgreSQL names are examples; never reuse this password in deployment.
POSTGRES_DB=campus_plus
POSTGRES_USER=campus_user
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_A_UNIQUE_RANDOM_VALUE
POSTGRES_PORT=5432

# Local Django uses SQLite when POSTGRES_HOST is absent.
# Docker Compose sets POSTGRES_HOST=db for the web container.
