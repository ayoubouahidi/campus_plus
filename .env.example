# Development template only. Run ./setup.sh to generate real local secrets.
DJANGO_SECRET_KEY=CHANGE_ME_GENERATE_A_UNIQUE_RANDOM_VALUE
DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
DJANGO_HTTPS_ENABLED=false
DJANGO_PUBLIC_MEDIA_BASE_URL=http://localhost:8080
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false
REDIS_URL=redis://127.0.0.1:6379/0
WS_AUTH_BACKEND=token_dev

# Docker/PostgreSQL names are examples; never reuse this password in deployment.
POSTGRES_DB=campus_plus
POSTGRES_USER=campus_user
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_A_UNIQUE_RANDOM_VALUE
POSTGRES_PORT=5432

# Local Django uses SQLite when POSTGRES_HOST is absent.
# Docker Compose sets POSTGRES_HOST=db for the web container.

# Email verification uses the console backend locally. Configure SMTP in
# production so signup verification codes can be delivered to users.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_USE_TLS=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@campushub.local
# Production SMTP example:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=your-smtp-user
# EMAIL_HOST_PASSWORD=your-smtp-password
# DEFAULT_FROM_EMAIL=Campus Hub <noreply@example.com>
