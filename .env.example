# Copy to .env (never commit .env) and fill in. Every variable the stack reads, by service.
# Owners: Django/DB/Redis = Ahmed & Ayoub, login = Ayoub (42 app) + Mouad (frontend), infra = Hamza.

# ---- Database (db + web) ----
POSTGRES_DB=campus_plus
POSTGRES_USER=campus_user
POSTGRES_PASSWORD=change-me

# ---- Django (web) ----
SECRET_KEY=change-me-long-random-string
DEBUG=true

# ---- Frontend login: Auth.js (frontend), see frontend/DOCS.md §7.5 ----
# Encrypts the session cookie. Generate: openssl rand -base64 32. One per environment.
AUTH_SECRET=
# Public address of the site, no trailing slash (https://campusplus.ma in production).
AUTH_URL=https://localhost
# 42 Intra app keys. The 42 app's redirect URI must include ${AUTH_URL}/api/auth/callback/42-school.
AUTH_42_SCHOOL_ID=
AUTH_42_SCHOOL_SECRET=
# Django base URL the Next.js server calls (POST /auth/sync). Empty = dev fallback (no Django call, role STUDENT).
BACKEND_URL=
# Shared secret between Next.js and Django for /auth/sync (same value on both sides).
BACKEND_INTERNAL_KEY=
# true = "Dev login" button (mock student, no 42). Developer machines only, NEVER on a shared server.
AUTH_DEV_LOGIN=false
