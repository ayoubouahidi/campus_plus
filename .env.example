# Django
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=CHANGE_ME_GENERATE_A_UNIQUE_RANDOM_VALUE
DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,web,campushub.ma
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost,https://127.0.0.1,https://campushub.ma

# Compatibility alias consumed by the current Compose file.
CSRF_TRUSTED_ORIGINS=https://localhost,https://127.0.0.1,https://campushub.ma
DJANGO_HTTPS_ENABLED=true
DJANGO_SSL_REDIRECT=false
DJANGO_PUBLIC_MEDIA_BASE_URL=https://localhost

# PostgreSQL
POSTGRES_DB=campus_hub
POSTGRES_USER=campus_user
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_A_UNIQUE_RANDOM_VALUE
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis / Django Channels
REDIS_URL=redis://redis:6379/0
WS_AUTH_BACKEND=jwt

# Shared by Django and the frontend server. Generate a long random value.
BACKEND_INTERNAL_KEY=replace-with-a-long-random-value

# Student frontend / Auth.js
AUTH_SECRET=replace-with-a-random-secret-at-least-32-bytes
AUTH_URL=https://localhost
AUTH_42_SCHOOL_ID=
AUTH_42_SCHOOL_SECRET=
AUTH_DEV_LOGIN=false
BACKEND_URL=http://backend:8000

# Email (dev: console backend, prod: SMTP)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=campushub.1337.team@gmail.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="Campus Hub <campushub.1337.team@gmail.com>"

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-password

ALLOWED_42_CAMPUSES=Benguerir,Khouribga,Tetouan,Rabat
# HTTP Strict Transport Security
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false
