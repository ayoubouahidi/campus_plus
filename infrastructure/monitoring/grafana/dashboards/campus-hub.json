                    "refId": "A"
                }
            ],
            "title": "Host Memory Usage (%)",
            "type": "timeseries"
        },
        {
            "datasource": "Prometheus",
            "fieldConfig": {
                "defaults": {
                    "max": 100,
                    "min": 0,
