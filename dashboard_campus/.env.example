# Generate a unique secret with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-random-secret
AUTH_TRUST_HOST=true
# Public HTTPS origin of this dashboard; used for the 42 OAuth callback URL.
AUTH_URL=https://dashboard.localhost
# Internal Docker-network address of the Django backend.
BACKEND_URL=http://backend:8000
BACKEND_INTERNAL_KEY=replace-with-a-local-development-key

# 42 Intra OAuth application credentials.
AUTH_42_SCHOOL_ID=
AUTH_42_SCHOOL_SECRET=
